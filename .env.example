# I-Con — Auth.js + Keycloak (OIDC Authorization Code + PKCE S256)
# Copy to .env.local and replace placeholders. Never commit .env.local.

# Canonical public origin used by Auth.js. Local production test value:
AUTH_URL=http://localhost:3000

# Encrypts the Auth.js session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=MPptTml+pDIaEGA2NuqeoqYj5aCvANpQI0c21lxzGA4=

# Keycloak confidential client (Realm: I-Con)
AUTH_KEYCLOAK_ID=icon-bff
# Keycloak Admin Console > Clients > icon-bff > Credentials > Client secret
AUTH_KEYCLOAK_SECRET=IpBGkcIwi7dzxBm1ZTSQFSys4HYKWPuh6rlnqnZeqcMxaW3uo6LiZaIbUv2yL1VBPLqGiQ2x26eCSzCgUTbF2c
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/I-Con

# Dedicated server-only, read-only Keycloak Admin REST client.
# Do not reuse icon-bff or expose these values through NEXT_PUBLIC_* variables.
ICON_KEYCLOAK_ADMIN_URL=http://localhost:8080
ICON_KEYCLOAK_REALM=I-Con
ICON_KEYCLOAK_DIRECTORY_CLIENT_ID=icon-directory-reader
ICON_KEYCLOAK_DIRECTORY_CLIENT_SECRET=qnX5lkClcsjM9u1coxwviB3nD6yHdMy7DCxTSB3a8CgIZ4anC5EL0Z5lgMPLxzXLXimPod1O8fOAJX3n8cgIyC

# RG-37 protection configuration. Provisioning must validate the pinned UUID association and
# role visibility before changing either validation attestation to true.
ICON_KEYCLOAK_REALM_MANAGEMENT_CLIENT_UUID=af0fde5d-99e9-4aac-ae11-f26b141856cb
ICON_KEYCLOAK_REALM_MANAGEMENT_CLIENT_UUID_VALIDATED=true
ICON_KEYCLOAK_REALM_MANAGEMENT_ROLE_VISIBILITY_VALIDATED=true
ICON_KEYCLOAK_REALM_ADMINISTRATION_ROLES=[]
ICON_KEYCLOAK_REALM_ADMINISTRATION_ROLE_VISIBILITY_VALIDATED=false
ICON_KEYCLOAK_SSO_ADMINISTRATORS_GROUP_PATH=/Administrateurs-SSO

# Reverse-proxy deployments only. Enable this only when the proxy overwrites
# Host, X-Forwarded-Host, and X-Forwarded-Proto and the app is not directly exposed.
# AUTH_TRUST_HOST=true


ICON_KEYCLOAK_DIRECTORY_APPROVED_TEST_ACCOUNT_IDS=f09a11f6-ee00-444c-9cdc-a21e654a2dbc

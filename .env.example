# I-Con — Auth.js + Keycloak (OIDC Authorization Code + PKCE S256)
# Copy to .env.local and replace placeholders. Never commit .env.local.

# Canonical public origin used by Auth.js. Local production test value:
AUTH_URL=http://localhost:3000

# Encrypts the Auth.js session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=pwzfMdjKo-6oMpGeu9ptLyKL03rKt2ygYP5-cp6WhgI

# Keycloak confidential client (Realm: I-Con)
AUTH_KEYCLOAK_ID=icon-bff
# Keycloak Admin Console > Clients > icon-bff > Credentials > Client secret
AUTH_KEYCLOAK_SECRET=7574QPFOWhF3UVIZ9hfALDepNbtrpLw8
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/I-Con

# Local GET /api/users verification only: comma-separated Keycloak user IDs.
# Never use this test allowlist as the production visibility resolver.
# ICON_KEYCLOAK_DIRECTORY_APPROVED_TEST_ACCOUNT_IDS=uuid-1,uuid-2

# Reverse-proxy deployments only. Enable this only when the proxy overwrites
# Host, X-Forwarded-Host, and X-Forwarded-Proto and the app is not directly exposed.
# AUTH_TRUST_HOST=true
